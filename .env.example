# LangGraph Skills: Environment Configuration Template

# 1. API Key configurations (Either DEEPSEEK_API_KEY or OPENAI_API_KEY is required depending on your models)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional: path to a file containing the DeepSeek API key (supports ~ expansion).
# Used as a fallback when DEEPSEEK_API_KEY is not set.
# DEEPSEEK_API_KEY_FILE=/path/to/your/deepseek_api.txt
OPENAI_API_KEY=your_openai_api_key_here

# 2. Engine settings (all optional; defaults shown)
# LGSKILLS_MODEL=deepseek-chat
# LGSKILLS_BASE_URL=https://api.deepseek.com/v1
# LGSKILLS_TEMPERATURE=0
# LGSKILLS_STRICT=false        # true 时未知 section 由 warning 升级为 error

# 3. LangGraph Studio settings
# Specify the default compiled Markdown Skill path to be loaded in LangGraph Studio
STUDIO_SKILL_PATH=assistant_compiled.md
